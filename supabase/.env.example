# Supabase Edge Functions Environment Variables Example
# Copy this file to supabase/.env for local edge function testing:
# cp supabase/.env.example supabase/.env

# The Supabase project URL and service role key (automatically injected in production by Supabase, but needed for local emulation/testing)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-goes-here

# The WhatsApp Phone Number where client orders will be sent (include country code without + or spaces)
# Example: 237690000000 (Cameroun)
WHATSAPP_CONTACT=237690000000
